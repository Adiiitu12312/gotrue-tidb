# Supabase Auth configuration for MySQL 8.0
GOTRUE_JWT_SECRET="test-secret-change-this-in-production-use-a-strong-secret"
GOTRUE_JWT_EXP="3600"
GOTRUE_JWT_AUD="authenticated"
GOTRUE_JWT_DEFAULT_GROUP_NAME="authenticated"
GOTRUE_JWT_ADMIN_ROLES="supabase_admin,service_role"

# Database & API connection details for MySQL
GOTRUE_DB_DRIVER="mysql"
DB_NAMESPACE="auth"
DATABASE_URL="mysql://supabase_auth_admin:root@tcp(localhost:3306)/auth?parseTime=true&multiStatements=true"
GOTRUE_DB_AUTOMIGRATE="true"
API_EXTERNAL_URL="http://localhost:9999"
GOTRUE_API_HOST="localhost"
PORT="9999"

GOTRUE_LOG_LEVEL="info"
GOTRUE_SITE_URL="http://localhost:3000"
GOTRUE_URI_ALLOW_LIST="http://localhost:3000"

GOTRUE_MAILER_AUTOCONFIRM="true"
GOTRUE_MAILER_URLPATHS_CONFIRMATION="/verify"
GOTRUE_MAILER_URLPATHS_INVITE="/verify"
GOTRUE_MAILER_URLPATHS_RECOVERY="/verify"
GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE="/verify"
